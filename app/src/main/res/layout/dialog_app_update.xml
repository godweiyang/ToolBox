<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/update_dialog_bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvUpdateIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/icon_grad_share"
        android:contentDescription="@string/update_check"
        android:gravity="center"
        android:text="↑"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvUpdateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:gravity="center"
        style="@style/Text.iOS.Headline" />

    <TextView
        android:id="@+id/tvUpdateSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/type_caption" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:maxHeight="220dp">

        <TextView
            android:id="@+id/tvUpdateNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ios_glass_field"
            android:lineSpacingExtra="3dp"
            android:padding="@dimen/glass_padding"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/type_body" />
    </ScrollView>

</LinearLayout>
