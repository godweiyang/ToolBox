<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/update_dialog_bg"
    android:maxWidth="340dp"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvUpdateIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/icon_grad_share"
        android:contentDescription="@string/update_check"
        android:gravity="center"
        android:text="↑"
        android:textColor="@color/white"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvUpdateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="#1C1C28"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvUpdateSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="#8A8E99"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="120dp"
        android:scrollbars="none">

        <TextView
            android:id="@+id/tvUpdateNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/update_notes_bg"
            android:lineSpacingExtra="2dp"
            android:padding="10dp"
            android:textColor="#555763"
            android:textSize="12.5sp" />
    </ScrollView>

    <ProgressBar
        android:id="@+id/pbUpdate"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:indeterminateTint="#5856D6"
        android:max="100"
        android:progressTint="#5856D6"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvUpdateProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="#8A8E99"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnUpdateGo"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/update_btn_primary"
        android:stateListAnimator="@null"
        android:text="@string/update_download_install"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUpdateBrowser"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:stateListAnimator="@null"
            android:text="@string/update_open_browser"
            android:textAllCaps="false"
            android:textColor="#8A8E99"
            android:textSize="13.5sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUpdateLater"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:stateListAnimator="@null"
            android:text="@string/update_later"
            android:textAllCaps="false"
            android:textColor="#8A8E99"
            android:textSize="13.5sp" />
    </LinearLayout>

</LinearLayout>
