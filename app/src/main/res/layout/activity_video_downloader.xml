<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ios_bg_gradient"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 共享页面头：Large Title + 副标题 -->
        <include
            android:id="@+id/downloaderHeader"
            layout="@layout/view_page_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_side"
            android:paddingEnd="@dimen/screen_side"
            android:paddingBottom="@dimen/space_6">

            <!-- 输入玻璃卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ios_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/glass_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.iOS.CardTitle"
                    android:text="@string/label_input" />

                <EditText
                    android:id="@+id/etShareText"
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:layout_marginTop="@dimen/space_3"
                    android:background="@drawable/ios_glass_field"
                    android:gravity="top|start"
                    android:hint="@string/hint_input"
                    android:inputType="textMultiLine"
                    android:padding="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPaste"
                        style="@style/Widget.iOS.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_paste"
                        app:icon="@android:drawable/ic_menu_set_as"
                        app:iconTint="@color/ios_blue"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClear"
                        style="@style/Widget.iOS.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_weight="1"
                        android:text="@string/btn_clear"
                        app:icon="@android:drawable/ic_menu_close_clear_cancel"
                        app:iconTint="@color/ios_blue"
                        app:iconSize="18dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownload"
                    style="@style/Widget.iOS.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/btn_download"
                    app:icon="@android:drawable/stat_sys_download"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white" />
            </LinearLayout>

            <!-- B 站状态玻璃卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/ios_glass_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/glass_padding"
                android:paddingEnd="@dimen/space_2"
                android:paddingTop="@dimen/space_2"
                android:paddingBottom="@dimen/space_2">

                <TextView
                    android:id="@+id/tvBiliStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="B站：未登录（480P）"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBiliLogin"
                    style="@style/Widget.iOS.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="B站登录"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 进度区 -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/ios_blue"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="@dimen/space_1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- 运行日志 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:layout_marginStart="@dimen/space_1"
                style="@style/Text.iOS.CardTitle"
                android:text="运行日志" />

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/ios_log_bg"
                android:fontFamily="monospace"
                android:minHeight="140dp"
                android:padding="@dimen/space_4"
                android:text="@string/log_initial"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
