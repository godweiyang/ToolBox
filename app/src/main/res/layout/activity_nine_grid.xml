<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ios_bg_gradient"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 共享页面头 -->
        <include
            android:id="@+id/ngHeader"
            layout="@layout/view_page_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_side"
            android:paddingEnd="@dimen/screen_side"
            android:paddingBottom="@dimen/space_6">

            <!-- 选择与预览卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ios_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/glass_padding">

                <TextView
                    android:id="@+id/tvImageInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.iOS.CardTitle"
                    android:text="@string/ng_input_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/space_3">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPick"
                        style="@style/Widget.iOS.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/ng_btn_pick" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClear"
                        style="@style/Widget.iOS.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:text="@string/ng_btn_clear" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ng_preview_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="@dimen/space_3"
                    android:paddingBottom="@dimen/space_2" />

                <!-- 九宫格预览 -->
                <GridLayout
                    android:id="@+id/gridPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="3"
                    android:useDefaultMargins="true"
                    android:layout_marginTop="@dimen/space_1" />
            </LinearLayout>

            <!-- 保存按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveAll"
                style="@style/Widget.iOS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/ng_btn_save_all"
                android:enabled="false"
                app:backgroundTint="@color/douyin_red" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
