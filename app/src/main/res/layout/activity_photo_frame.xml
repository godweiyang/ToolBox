<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ios_bg_gradient"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tool_photoframe_title"
            android:textAppearance="@style/Text.iOS.LargeTitle"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pf_subtitle"
            android:textAppearance="@style/Text.iOS.Caption"
            android:paddingBottom="14dp" />

        <!-- 预览玻璃卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/ios_glass_card"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:adjustViewBounds="true"
                android:background="#14000000"
                android:contentDescription="@string/pf_preview_desc"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pf_idle"
                android:textAppearance="@style/Text.iOS.Caption"
                android:gravity="center"
                android:paddingTop="10dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPick"
            style="@style/Widget.iOS.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/pf_btn_pick" />

        <Button
            android:id="@+id/btnSave"
            style="@style/Widget.iOS.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:enabled="false"
            android:text="@string/pf_btn_save" />

        <Button
            android:id="@+id/btnShare"
            style="@style/Widget.iOS.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:enabled="false"
            android:text="@string/pf_btn_share" />

    </LinearLayout>
</ScrollView>
