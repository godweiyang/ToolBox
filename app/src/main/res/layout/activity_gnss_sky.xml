<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ios_bg_gradient"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_6">

        <!-- 共享页面头 -->
        <include
            android:id="@+id/gnssHeader"
            layout="@layout/view_page_header" />

        <!-- 权限提示（未授权时显示）：保留 id=permissionPrompt 供 Kotlin 切可见性 -->
        <LinearLayout
            android:id="@+id/permissionPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginEnd="@dimen/screen_side"
            android:background="@drawable/ios_glass_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_6"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/gnss_permission_prompt"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_body" />
        </LinearLayout>

        <!-- 顶部状态 -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="@dimen/space_2"
            android:text="初始化中…"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/type_caption" />

        <!-- 4 大统计卡片：复用共享 view_metric_card -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:paddingStart="@dimen/space_2"
            android:paddingEnd="@dimen/space_2">

            <include
                android:id="@+id/cardVisible"
                layout="@layout/view_metric_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/space_1" />

            <include
                android:id="@+id/cardUsed"
                layout="@layout/view_metric_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/space_1" />

            <include
                android:id="@+id/cardAvgCn0"
                layout="@layout/view_metric_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/space_1" />

            <include
                android:id="@+id/cardAccuracy"
                layout="@layout/view_metric_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/space_1" />
        </GridLayout>

        <!-- 定位信息行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginEnd="@dimen/screen_side"
            android:background="@drawable/ios_glass_card"
            android:orientation="horizontal"
            android:weightSum="4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_3"
                android:paddingBottom="@dimen/space_3">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="纬度"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/type_footnote" />

                <TextView
                    android:id="@+id/tvLat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="--"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/type_caption"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_3"
                android:paddingBottom="@dimen/space_3">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="经度"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/type_footnote" />

                <TextView
                    android:id="@+id/tvLon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="--"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/type_caption"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_3"
                android:paddingBottom="@dimen/space_3">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="速度"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/type_footnote" />

                <TextView
                    android:id="@+id/tvSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="--"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/type_caption"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_3"
                android:paddingBottom="@dimen/space_3">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="定位延迟"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/type_footnote" />

                <TextView
                    android:id="@+id/tvFixAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="--"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/type_caption"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 天空图 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginEnd="@dimen/screen_side"
            android:text="@string/gnss_section_skyplot"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/type_card_title"
            android:textStyle="bold" />

        <com.example.videodownloader.SkyplotView
            android:id="@+id/skyplot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginEnd="@dimen/screen_side"
            android:background="@drawable/ios_glass_field"
            android:padding="@dimen/space_2" />

        <!-- 选中卫星详情 -->
        <TextView
            android:id="@+id/tvSelectedSat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center"
            android:paddingStart="@dimen/screen_side"
            android:paddingEnd="@dimen/screen_side"
            android:textColor="@color/ios_blue"
            android:textSize="@dimen/type_caption"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 星座统计 -->
        <TextView
            android:id="@+id/tvConstellations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="@dimen/space_2"
            android:text="--"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/type_caption" />

        <!-- 信号曲线 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginEnd="@dimen/screen_side"
            android:text="@string/gnss_section_chart"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/type_card_title"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginEnd="@dimen/screen_side"
            android:background="@drawable/ios_glass_field"
            android:orientation="vertical"
            android:padding="@dimen/glass_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_2"
                android:text="平均载噪比 C/N0 (dB-Hz)"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_caption" />

            <com.example.videodownloader.MetalChartView
                android:id="@+id/chartCn0"
                android:layout_width="match_parent"
                android:layout_height="110dp" />
        </LinearLayout>

        <!-- 卫星列表 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginEnd="@dimen/screen_side"
            android:text="@string/gnss_section_list"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/type_card_title"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/satListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginEnd="@dimen/screen_side"
            android:background="@drawable/ios_glass_card"
            android:orientation="vertical" />

        <!-- 说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginEnd="@dimen/screen_side"
            android:text="@string/gnss_hint"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/type_footnote" />

    </LinearLayout>
</ScrollView>
