<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ios_bg_gradient"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 共享页面头 -->
        <include
            android:id="@+id/vgfHeader"
            layout="@layout/view_page_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_side"
            android:paddingEnd="@dimen/screen_side"
            android:paddingBottom="@dimen/space_6">

            <!-- 视频导入卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ios_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/glass_padding">

                <TextView
                    android:id="@+id/tvVideoInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.iOS.CardTitle"
                    android:text="@string/vgf_input_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/space_3">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPick"
                        style="@style/Widget.iOS.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/vgf_btn_pick" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClear"
                        style="@style/Widget.iOS.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:text="@string/vgf_btn_clear" />
                </LinearLayout>

                <!-- 视频预览 + 裁剪框叠加 -->
                <FrameLayout
                    android:id="@+id/videoFrame"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="@dimen/space_3"
                    android:background="#000000">

                    <VideoView
                        android:id="@+id/videoPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />

                    <!-- 精确帧预览 -->
                    <ImageView
                        android:id="@+id/ivPreciseFrame"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <com.example.videodownloader.CropOverlayView
                        android:id="@+id/cropOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <!-- 时间提示，叠在视频左上角 -->
                    <TextView
                        android:id="@+id/tvFrameTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="@dimen/space_2"
                        android:background="#80000000"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:padding="@dimen/space_1"
                        android:text="0.0s" />
                </FrameLayout>
            </LinearLayout>

            <!-- 时间段选取卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/ios_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/glass_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.iOS.CardTitle"
                    android:text="@string/vgf_section_time" />

                <TextView
                    android:id="@+id/tvTimeRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:text="0.0s - 0.0s" />

                <!-- 起始时间 SeekBar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target_min">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="起"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:paddingEnd="@dimen/space_2" />

                    <SeekBar
                        android:id="@+id/sbStart"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:max="1000"
                        android:progress="0" />
                </LinearLayout>

                <!-- 结束时间 SeekBar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target_min">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="止"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:paddingEnd="@dimen/space_2" />

                    <SeekBar
                        android:id="@+id/sbEnd"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:max="1000"
                        android:progress="300" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="拖动预览图里的白色边框或手柄调整裁剪区域"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 输出选项卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/ios_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/glass_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.iOS.CardTitle"
                    android:text="@string/vgf_section_options" />

                <TextView
                    android:id="@+id/tvFps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/space_2"
                    android:textColor="@color/text_primary" />

                <SeekBar
                    android:id="@+id/sbFps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:max="20"
                    android:progress="14" />

                <TextView
                    android:id="@+id/tvWidth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/space_2"
                    android:textColor="@color/text_primary" />

                <SeekBar
                    android:id="@+id/sbWidth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:max="720"
                    android:progress="480" />

                <TextView
                    android:id="@+id/tvQuality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/space_2"
                    android:textColor="@color/text_primary" />

                <SeekBar
                    android:id="@+id/sbQuality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:max="29"
                    android:progress="9" />
            </LinearLayout>

            <!-- 生成按钮 + 进度 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerate"
                style="@style/Widget.iOS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:text="@string/vgf_btn_generate"
                app:backgroundTint="@color/douyin_red" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/douyin_red"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:visibility="gone"
                android:paddingTop="@dimen/space_1" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
