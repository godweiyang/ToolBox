<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <TextView
        android:id="@+id/tvRowIndex"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:textColor="#98A4AF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvRowDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#1C2B36"
        android:textSize="13.5sp" />

    <TextView
        android:id="@+id/tvRowPrepay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/mortgage_prepay_badge"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="@string/mortgage_prepay_short"
        android:textColor="#C8881B"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvRowPay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#0F3B5D"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
