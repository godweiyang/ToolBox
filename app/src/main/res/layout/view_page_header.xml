<?xml version="1.0" encoding="utf-8"?>
<!-- 共享页面头：iOS Large Title + 副标题。
     用法：<include layout="@layout/view_page_header" android:id="@+id/xxxHeader"/>
     代码里 binding.xxxHeader.pageTitle / pageSubtitle 设置文案。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_side"
    android:paddingEnd="@dimen/screen_side"
    android:paddingTop="18dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/pageTitle"
        style="@style/Text.iOS.LargeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="工具百宝箱" />

    <TextView
        android:id="@+id/pageSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        tools:text="轻量实用工具合集" />
</LinearLayout>
