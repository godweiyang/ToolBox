<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_side"
        android:paddingEnd="@dimen/screen_side"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_4">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Text.iOS.Headline"
            android:gravity="center"
            android:paddingBottom="@dimen/space_3"
            android:text="@string/tool_qrcode_title" />

        <!-- 输入区卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ios_glass_card"
            android:orientation="vertical"
            android:padding="@dimen/glass_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qr_input_label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_caption"
                android:paddingBottom="@dimen/space_2" />

            <EditText
                android:id="@+id/etQrInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/qr_input_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="@dimen/touch_target_min"
                android:maxLines="3"
                android:textSize="@dimen/type_body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQrPaste"
                    style="@style/Widget.iOS.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/qr_btn_paste" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQrClear"
                    style="@style/Widget.iOS.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/qr_btn_clear" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerate"
                style="@style/Widget.iOS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/qr_btn_generate" />
        </LinearLayout>

        <!-- 预览区卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/ios_glass_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/glass_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="@dimen/space_2"
                android:text="@string/qr_preview_hint"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_caption" />

            <ImageView
                android:id="@+id/ivQrPreview"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:background="#FFFFFFFF"
                android:contentDescription="@string/qr_preview_hint"
                android:scaleType="fitCenter" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.iOS.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:enabled="false"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/qr_btn_save" />
        </LinearLayout>

        <!-- 样式设置卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/ios_glass_card"
            android:orientation="vertical"
            android:padding="@dimen/glass_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Text.iOS.CardTitle"
                android:paddingBottom="@dimen/space_2"
                android:text="@string/qr_section_style" />

            <!-- 前景色 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_2"
                android:text="@string/qr_fore_color"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_body" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_2"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llForeColors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 背景色 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_4"
                android:text="@string/qr_back_color"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_body" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_2"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llBackColors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 点阵样式 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_4"
                android:text="@string/qr_dot_style"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_body" />

            <RadioGroup
                android:id="@+id/rgDotStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_1">

                <RadioButton
                    android:id="@+id/rbSquare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:padding="@dimen/space_2"
                    android:text="@string/qr_dot_square"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbRound"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:padding="@dimen/space_2"
                    android:text="@string/qr_dot_round" />
            </RadioGroup>

            <!-- 容错等级 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_4"
                android:text="@string/qr_error_correction"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_body" />

            <RadioGroup
                android:id="@+id/rgEcLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_1">

                <RadioButton
                    android:id="@+id/rbEcL"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:padding="@dimen/space_1"
                    android:text="@string/qr_ec_l" />

                <RadioButton
                    android:id="@+id/rbEcM"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:padding="@dimen/space_1"
                    android:text="@string/qr_ec_m" />

                <RadioButton
                    android:id="@+id/rbEcQ"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:padding="@dimen/space_1"
                    android:text="@string/qr_ec_q" />

                <RadioButton
                    android:id="@+id/rbEcH"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:padding="@dimen/space_1"
                    android:text="@string/qr_ec_h"
                    android:checked="true" />
            </RadioGroup>

            <!-- 边距 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_4"
                android:text="@string/qr_margin"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_body" />

            <SeekBar
                android:id="@+id/sbMargin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:max="8"
                android:progress="1" />

            <!-- Logo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_4"
                android:text="@string/qr_logo"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickLogo"
                    style="@style/Widget.iOS.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/qr_logo_pick" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearLogo"
                    style="@style/Widget.iOS.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/qr_logo_clear" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivLogoPreview"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_2"
                android:contentDescription="@string/qr_logo"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
