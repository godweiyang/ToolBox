<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_side"
        android:paddingEnd="@dimen/screen_side"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_4">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Text.iOS.Headline"
            android:gravity="center"
            android:paddingBottom="@dimen/space_3"
            android:text="@string/tool_fileshare_title" />

        <!-- 服务状态 -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ios_glass_card"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:paddingTop="@dimen/space_3"
            android:paddingBottom="@dimen/space_3"
            android:text="@string/fs_status_off"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/type_card_title"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggle"
            style="@style/Widget.iOS.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/fs_btn_start" />

        <!-- 扫码 / 地址卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/ios_glass_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/glass_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="@dimen/space_2"
                android:text="@string/fs_qr_hint"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_caption" />

            <ImageView
                android:id="@+id/ivQrCode"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:background="#FFFFFFFF"
                android:contentDescription="@string/fs_qr_hint"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:gravity="center"
                android:textColor="@color/ds_primary"
                android:textSize="@dimen/type_card_title"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center"
                android:text="@string/fs_same_wifi_hint"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/type_footnote" />
        </LinearLayout>

        <!-- 已接收文件 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            style="@style/Text.iOS.CardTitle"
            android:paddingBottom="@dimen/space_2"
            android:text="@string/fs_received" />

        <TextView
            android:id="@+id/tvReceivedCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/space_2"
            android:text="@string/fs_no_files"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/type_caption" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvReceived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
