<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ios_bg_gradient"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 共享页面头 -->
        <include
            android:id="@+id/grHeader"
            layout="@layout/view_page_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_side"
            android:paddingEnd="@dimen/screen_side"
            android:paddingBottom="@dimen/space_6">

            <!-- 导入与预览卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ios_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/glass_padding">

                <TextView
                    android:id="@+id/tvGifInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.iOS.CardTitle"
                    android:text="@string/gr_input_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/space_3">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPick"
                        style="@style/Widget.iOS.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/gr_btn_pick" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClear"
                        style="@style/Widget.iOS.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:text="@string/gr_btn_clear" />
                </LinearLayout>

                <!-- 原图 / 倒放预览并排 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/space_4"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.iOS.Caption"
                            android:text="@string/gr_original"
                            android:paddingBottom="@dimen/space_1" />

                        <ImageView
                            android:id="@+id/ivOriginal"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:background="#EEEEEE"
                            android:scaleType="fitCenter" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.iOS.Caption"
                            android:text="@string/gr_reversed"
                            android:paddingBottom="@dimen/space_1" />

                        <ImageView
                            android:id="@+id/ivReversed"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:background="#EEEEEE"
                            android:scaleType="fitCenter" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 输出选项卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/ios_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/glass_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.iOS.CardTitle"
                    android:text="@string/gr_section_options" />

                <SeekBar
                    android:id="@+id/sbFrames"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:minHeight="@dimen/touch_target_min"
                    android:max="48"
                    android:progress="20" />

                <TextView
                    android:id="@+id/tvFrames"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 进度 -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:visibility="gone"
                android:progressTint="@color/douyin_red"
                android:max="100" />

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:visibility="gone"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:paddingTop="@dimen/space_1" />

            <!-- 生成按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerate"
                style="@style/Widget.iOS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/gr_btn_generate"
                android:enabled="false"
                app:backgroundTint="@color/douyin_red" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.iOS.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/gr_btn_save"
                android:enabled="false" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
