<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ios_bg_gradient"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_6">

        <!-- 共享页面头 -->
        <include
            android:id="@+id/batteryHeader"
            layout="@layout/view_page_header" />

        <!-- 顶部：电量百分比 + 状态（玻璃卡） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginEnd="@dimen/screen_side"
            android:background="@drawable/ios_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/glass_padding">

            <TextView
                android:id="@+id/tvLevelBig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--%"
                android:textColor="@color/tool_battery_bg"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:text="--"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_body" />
        </LinearLayout>

        <!-- 电池端标注 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginEnd="@dimen/screen_side"
            android:text="@string/battery_section_bat_side"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/type_card_title"
            android:textStyle="bold" />

        <!-- 4 大指标卡片：复用共享 view_metric_card -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:paddingStart="@dimen/space_2"
            android:paddingEnd="@dimen/space_2">

            <include
                android:id="@+id/cardCurrent"
                layout="@layout/view_metric_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/space_1" />

            <include
                android:id="@+id/cardVoltage"
                layout="@layout/view_metric_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/space_1" />

            <include
                android:id="@+id/cardPower"
                layout="@layout/view_metric_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/space_1" />

            <include
                android:id="@+id/cardTemp"
                layout="@layout/view_metric_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/space_1" />
        </GridLayout>

        <!-- 充电器输入端（Vbus 侧）：sysfs 可读时显示 -->
        <LinearLayout
            android:id="@+id/inputCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginEnd="@dimen/screen_side"
            android:background="@drawable/ios_glass_card"
            android:orientation="vertical"
            android:padding="@dimen/glass_padding"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/battery_section_input_side"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/type_card_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInputSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/type_footnote" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:orientation="horizontal"
                android:weightSum="3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvInputVoltage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="输入电压 V"
                        android:textColor="@color/text_tertiary"
                        android:textSize="@dimen/type_footnote" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvInputCurrent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="输入电流 A"
                        android:textColor="@color/text_tertiary"
                        android:textSize="@dimen/type_footnote" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvInputPower"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="输入功率 W"
                        android:textColor="@color/text_tertiary"
                        android:textSize="@dimen/type_footnote" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 实时曲线 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginEnd="@dimen/screen_side"
            android:text="@string/battery_section_chart"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/type_card_title"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:paddingStart="@dimen/space_2"
            android:paddingEnd="@dimen/space_2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/space_1"
                android:background="@drawable/ios_glass_field"
                android:orientation="vertical"
                android:padding="@dimen/space_3">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_1"
                    android:text="电流 (mA)"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/type_caption" />

                <com.example.videodownloader.MetalChartView
                    android:id="@+id/chartCurrent"
                    android:layout_width="match_parent"
                    android:layout_height="110dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/space_1"
                android:background="@drawable/ios_glass_field"
                android:orientation="vertical"
                android:padding="@dimen/space_3">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_1"
                    android:text="电压 (V)"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/type_caption" />

                <com.example.videodownloader.MetalChartView
                    android:id="@+id/chartVoltage"
                    android:layout_width="match_parent"
                    android:layout_height="110dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/space_1"
                android:background="@drawable/ios_glass_field"
                android:orientation="vertical"
                android:padding="@dimen/space_3">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_1"
                    android:text="功率 (W)"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/type_caption" />

                <com.example.videodownloader.MetalChartView
                    android:id="@+id/chartPower"
                    android:layout_width="match_parent"
                    android:layout_height="110dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/space_1"
                android:background="@drawable/ios_glass_field"
                android:orientation="vertical"
                android:padding="@dimen/space_3">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_1"
                    android:text="温度 (°C)"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/type_caption" />

                <com.example.videodownloader.MetalChartView
                    android:id="@+id/chartTemp"
                    android:layout_width="match_parent"
                    android:layout_height="110dp" />
            </LinearLayout>
        </GridLayout>

        <!-- 全部参数（动态生成） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginEnd="@dimen/screen_side"
            android:text="@string/battery_section_details"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/type_card_title"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/detailsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginEnd="@dimen/screen_side"
            android:background="@drawable/ios_glass_card"
            android:orientation="vertical" />

        <!-- 广播原始数据 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginEnd="@dimen/screen_side"
            android:text="@string/battery_section_raw"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/type_card_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRawExtras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginEnd="@dimen/screen_side"
            android:background="@drawable/ios_glass_field"
            android:fontFamily="monospace"
            android:padding="@dimen/space_3"
            android:text="--"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/type_footnote" />

        <!-- 电源节点 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginEnd="@dimen/screen_side"
            android:text="@string/battery_section_sysfs"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/type_card_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSysfs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginEnd="@dimen/screen_side"
            android:background="@drawable/ios_glass_field"
            android:fontFamily="monospace"
            android:padding="@dimen/space_3"
            android:text="读取中…"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/type_footnote" />

        <!-- 温度节点 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginEnd="@dimen/screen_side"
            android:text="@string/battery_section_thermal"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/type_card_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvThermal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_side"
            android:layout_marginEnd="@dimen/screen_side"
            android:background="@drawable/ios_glass_field"
            android:fontFamily="monospace"
            android:padding="@dimen/space_3"
            android:text="读取中…"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/type_footnote" />
    </LinearLayout>
</ScrollView>
