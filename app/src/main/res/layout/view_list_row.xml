<?xml version="1.0" encoding="utf-8"?>
<!-- 共享列表行：可选图标 + 标题 + 副标题 + 尾部文本。48dp 高，带 ripple。
     图标视为装饰（importantForAccessibility=no），标题承担朗读。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ios_glass_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target_min"
    android:orientation="horizontal"
    android:paddingStart="@dimen/glass_padding"
    android:paddingEnd="@dimen/glass_padding"
    android:paddingTop="@dimen/space_3"
    android:paddingBottom="@dimen/space_3">

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:visibility="gone"
        tools:visibility="visible"
        tools:src="@android:drawable/ic_menu_info_details" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/type_card_title"
            android:textStyle="bold"
            tools:text="纬度" />

        <TextView
            android:id="@+id/rowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/type_caption"
            tools:text="31.2304° N" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowTrailing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_2"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/type_caption"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="›" />
</LinearLayout>
