<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_side"
        android:paddingEnd="@dimen/screen_side"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_4">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Text.iOS.Headline"
            android:gravity="center"
            android:paddingBottom="@dimen/space_3"
            android:text="@string/tool_wifi_title" />

        <!-- 连接信息卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ios_glass_card"
            android:orientation="vertical"
            android:padding="@dimen/glass_padding">

            <TextView
                android:id="@+id/tvSsid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_body"
                />

            <TextView
                android:id="@+id/tvFreq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_caption"
                />

            <TextView
                android:id="@+id/tvLinkSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_caption"
                />

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_caption"
                />

            <!-- 大 RSSI 读数 -->
            <TextView
                android:id="@+id/tvRssi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center"
                android:textColor="@color/wifi_excellent"
                android:textSize="56sp"
                android:textStyle="bold"
                android:importantForAccessibility="yes"
                android:accessibilityLiveRegion="polite" />

            <TextView
                android:id="@+id/tvLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/type_headline"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 统计：最小 / 平均 / 最大 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/ios_glass_card"
            android:orientation="horizontal"
            android:padding="@dimen/glass_padding">

            <TextView
                android:id="@+id/tvMin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_caption" />

            <TextView
                android:id="@+id/tvAvg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_caption" />

            <TextView
                android:id="@+id/tvMax"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_caption" />
        </LinearLayout>

        <!-- 实时曲线 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/ios_glass_field"
            android:orientation="vertical"
            android:padding="@dimen/glass_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_2"
                android:text="@string/wifi_chart_label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/type_caption" />

            <com.example.videodownloader.MetalChartView
                android:id="@+id/chartRssi"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:contentDescription="@string/wifi_chart_label" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggle"
            style="@style/Widget.iOS.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/wifi_btn_start" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center"
            android:text="@string/wifi_hint"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/type_footnote" />

    </LinearLayout>
</ScrollView>
