<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 全局 iOS 风格主题：浅色、无边框、蓝色强调 -->
    <style name="Theme.VideoDownloader" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/ios_blue</item>
        <item name="colorPrimaryVariant">@color/ios_indigo</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ios_cyan</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorError">@color/ios_red</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@drawable/ios_bg_gradient</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialButtonStyle">@style/Widget.iOS.Button</item>
        <item name="editTextStyle">@style/Widget.iOS.EditText</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- 主按钮：蓝色胶囊（关键触摸目标 >=48dp） -->
    <style name="Widget.iOS.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/control_corner</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/ds_ripple_primary</item>
    </style>

    <!-- 危险按钮：红色实心（删除/破坏性操作） -->
    <style name="Widget.iOS.Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/control_corner</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="elevation">0dp</item>
        <item name="backgroundTint">@color/ds_danger</item>
        <item name="android:textColor">@color/ds_on_danger</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- 次按钮：半透明玻璃 -->
    <style name="Widget.iOS.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/control_corner</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ios_blue</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="elevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">@color/glass_fill_strong</item>
        <item name="rippleColor">@color/ds_ripple_primary</item>
    </style>

    <!-- 输入框：玻璃圆角，无下划线 -->
    <style name="Widget.iOS.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/ios_glass_field</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">14dp</item>
    </style>

    <!-- 页面大标题（iOS Large Title） -->
    <style name="Text.iOS.LargeTitle" parent="@android:style/TextAppearance">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- 页面次级标题 -->
    <style name="Text.iOS.Headline" parent="@android:style/TextAppearance">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- 卡片标题 -->
    <style name="Text.iOS.CardTitle" parent="@android:style/TextAppearance">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 次要说明文字 -->
    <style name="Text.iOS.Caption" parent="@android:style/TextAppearance">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="FrameEditorTab" parent="@android:style/TextAppearance">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/frame_tab_text</item>
        <item name="android:background">@drawable/frame_editor_tab</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <!-- ===== Phase 0 设计系统：新增共享样式 ===== -->

    <!-- 正文 / 脚注 -->
    <style name="Text.iOS.Body" parent="@android:style/TextAppearance">
        <item name="android:textSize">@dimen/type_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.iOS.Footnote" parent="@android:style/TextAppearance">
        <item name="android:textSize">@dimen/type_footnote</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- 状态徽标 / 胶囊（可点按，内置 48dp 触摸目标） -->
    <style name="Widget.iOS.Badge" parent="@android:style/Widget.TextView">
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:textColor">@color/ios_blue</item>
        <item name="android:textSize">@dimen/type_footnote</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- 分段控件（TabLayout 磨砂玻璃容器） -->
    <style name="Widget.iOS.SegmentedControl" parent="Widget.Design.TabLayout">
        <item name="android:background">@drawable/ios_glass_field</item>
        <item name="tabMode">fixed</item>
        <item name="tabIndicatorColor">@color/ios_blue</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabSelectedTextColor">@color/ios_blue</item>
        <item name="tabTextColor">@color/text_secondary</item>
    </style>

    <!-- 磨砂玻璃卡片（MaterialCardView 容器统一外观） -->
    <style name="Widget.iOS.GlassCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="cardCornerRadius">@dimen/card_corner</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/ds_ripple_primary</item>
    </style>

    <style name="Widget.Home.DensityChip" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:background">@drawable/home_density_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="Mortgage" parent="@android:style/Widget" />

    <style name="Mortgage.FieldLabel" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">#5C6B77</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Mortgage.ResultCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/ios_glass_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="Mortgage.ResultLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#5C6B77</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Mortgage.ResultValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:textColor">#0F3B5D</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Mortgage.ResultValueSmall" parent="Mortgage.ResultValue">
        <item name="android:textSize">15sp</item>
    </style>

</resources>
